.externalNativeBuild

### Gradle ###
.gradle
build/

# Ignore Gradle project-level files
.idea/gradle.xml

# Ignore Gradle wrapper files
gradle-wrapper.jar

# Exclude Gradle logs files
/gradle/daemon/

