modules = ["java-graalvm22.3", "bash", "nix"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Project Info"

[[workflows.workflow]]
name = "Project Info"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"╔════════════════════════════════════════╗\" && echo \"║   LATAXI - PROYECTO ANDROID LISTO     ║\" && echo \"╚════════════════════════════════════════╝\" && echo \"\" && echo \"✅ Proyecto reestructurado para CodeMagic\" && echo \"\" && echo \"📁 Estructura:\" && echo \"   - app/              → Módulo Android\" && echo \"   - gradlew           → Build tool\" && echo \"   - codemagic.yaml    → CI/CD config\" && echo \"\" && echo \"🚀 Siguiente paso:\" && echo \"   Lee: INSTRUCCIONES_GIT.md\" && echo \"\" && echo \"📋 Resumen rápido:\" && echo \"   1. Abre el Shell de Replit\" && echo \"   2. git checkout -b apk-pasajeros\" && echo \"   3. git add .\" && echo \"   4. git commit -m 'Reestructuración para CodeMagic'\" && echo \"   5. git push [URL] apk-pasajeros\" && echo \"\" && echo \"📊 Stats:\" && echo \"   - $(find app/src -name '*.java' 2>/dev/null | wc -l) archivos Java\" && echo \"   - $(find app/src -name '*.xml' 2>/dev/null | wc -l) archivos XML\" && echo \"\" && echo \"🔗 Repositorio: github.com/jclouds312/Taxiapp\" && sleep infinity"

[workflows.workflow.metadata]
outputType = "console"
