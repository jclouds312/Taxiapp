modules = ["java-graalvm22.3", "bash", "nix"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Android Info"

[[workflows.workflow]]
name = "Android Info"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/android_info.sh"

[workflows.workflow.metadata]
outputType = "console"
